FUGLE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MAX_PRICE=100
TOP_N=100
DEEP_DIVE_N=12
MIN_VOLUME=500
MIN_TRADE_VALUE=10000000
STRICT_OFFICIAL_MODE=1
ALLOW_MIS_OTC_FALLBACK=1

# P0-R Risk & Portfolio Engine
ACCOUNT_EQUITY=0
RISK_PER_TRADE_PCT=0.005
DAILY_LOSS_LIMIT_PCT=0.015
MAX_PORTFOLIO_HEAT_PCT=0.03
MAX_POSITION_PCT=0.20
CORRELATION_LIMIT_PCT=0.02
MAX_CONCURRENT_POSITIONS=3
CAUTION_LOSS_STREAK=3
DEFENSIVE_LOSS_STREAK=5
LOCKDOWN_DRAWDOWN_PCT=0.06
LOT_SIZE=1000
DAILY_PNL=0
OPEN_RISK=0
CONCURRENT_POSITIONS=0
CORRELATED_OPEN_RISK=0
ACCOUNT_DRAWDOWN_PCT=0
CONSECUTIVE_LOSSES=0

# P0-A Alert & Monitoring Engine state persistence
# Local development: file
# Cloud production: redis + REDIS_URL
MONITOR_STATE_BACKEND=file
REDIS_URL=
MONITOR_STATE_REDIS_KEY=sky:p0a:monitor_state


# P0-X Execution Cost Model
# User-observed profiles:
#   USER_CASH_DAYTRADE_20261022
#   USER_MARGIN_FINANCING_20261021
EXEC_COST_PROFILE=USER_CASH_DAYTRADE_20261022
# Explicit values below override the selected profile.
# Leave blank when unknown. Blank is NOT zero.
EXEC_BUY_COMMISSION_RATE=
EXEC_SELL_COMMISSION_RATE=
EXEC_SELL_TAX_RATE=
EXEC_ENTRY_SLIPPAGE_BPS=
EXEC_EXIT_SLIPPAGE_BPS=
EXEC_SPREAD_BPS=
EXEC_LIQUIDITY_PENALTY_BPS=
EXEC_FILL_PROBABILITY=
# Required for complete margin Execution RR; e.g. 13 TWD / 1000 shares = 0.013
EXEC_FINANCING_INTEREST_PER_SHARE=
EXEC_MIN_RR=1.5
EXEC_ENFORCE_GATE=0


# P0-LAB / Paper Trading
# off | shadow | paper
# shadow = record candidates only; no simulated fills
PAPER_TRADING_MODE=shadow
P0S_OOS_VERDICT=REJECTED_OOS
PAPER_GCS_BUCKET=

# Rejected OOS strategy: keep disabled outside explicit research runs.
P0S_5M_BREAKOUT_ENABLED=0
